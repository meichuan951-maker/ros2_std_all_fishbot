<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 机器人的激光雷达部件 -->
  <xacro:macro name="laser_xacro" params="xyz">
    <link name="laser_cylinder_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <cylinder radius="0.02" length="0.10"/>
        </geometry>
        <material name="yellow">
          <color rgba="1.0 0.8 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <cylinder radius="0.02" length="0.10"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="0.08" radius="0.02" length="0.10" rpy="0.0 0.0 0.0"/>
    </link>

    <!-- 雷达 -->
    <link name="laser_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <cylinder radius="0.02" length="0.02"/>
        </geometry>
        <material name="yellow">
          <color rgba="1.0 0.8 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <cylinder radius="0.02" length="0.02"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="0.03" radius="0.02" length="0.02" rpy="0.0 0.0 0.0"/>
    </link>

    <!-- 底盘 -> 雷达支柱 -->
    <joint name="laser_cylinder_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser_cylinder_link"/>
      <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- 支柱 -> 雷达 -->
    <joint name="laser_joint" type="fixed">
      <parent link="laser_cylinder_link"/>
      <child link="laser_link"/>
      <origin xyz="0.0 0.0 0.06" rpy="0.0 0.0 0.0"/>
    </joint>

    <gazebo reference="laser_cylinder_link">
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

</robot>
