<?xml version="1.0"?>
<robot name="first_robot">
<!-- 机器人的身体部分 -->
  <link name="base_link">
  <!-- 部件的外观描述 -->
   <visual>
    <!-- 沿着几何中心的偏移和旋转量 -->
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <!-- 形状的几何描述 -->
    <geometry>
    <!-- 圆柱体 ,半径,高度 -->
      <cylinder radius="0.25" length="0.2"/>
    </geometry>
    <!-- 形状的材质描述 -->
    <material name="white">
      <color rgba="1.0 1.0 1.0 0.5"/>
    </material>
   </visual>
  </link>
  <!-- 机器人的IMU部件,惯性测量传感器 -->
    <link name="imu_link">
     <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
        <box size="0.02 0.02 0.02"/>
        </geometry>
        <material name="black">
        <color rgba="0.0 0.0 0.0 0.5"/>
        </material>
     </visual>
    </link>

<!--机器人的关节部件,用于组合机器人 -->
    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0.0 0.0 0.09" rpy="0.0 0.0 0.0"/>
    </joint>

</robot>
